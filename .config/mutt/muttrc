# Account
set realname = "`cat ~/.config/name`"
set from = "`cat ~/.config/email`"

# Imap settings
set imap_user = "`cat ~/.config/email`"
set imap_pass = "`echo $(gpg --batch -q --for-your-eyes-only --no-tty -d $(cat ~/.config/passwd-path))`"

# Smtp settings
set smtp_url = "`cat ~/.config/smtp-url`"
set smtp_pass = "`echo $(gpg --batch -q --for-your-eyes-only --no-tty -d $(cat ~/.config/passwd-path))`"

# Remote gmail folders
set folder = "imaps://imap.gmail.com/"
set spoolfile = "+INBOX"
set postponed = "+[Gmail]/Drafts"
set record = "+[Gmail]/Sent Mail"
set trash = "+[Gmail]/Trash"

mailboxes =INBOX "=[Gmail]/Sent Mail" "=[Gmail]/Trash" "=[Gmail]/Drafts"

# SSL
set ssl_force_tls = yes

# Customization
set sort=reverse-last-date-received
set strict_threads=yes
set pager_stop = yes
set menu_scroll = yes

set index_format = "%4C %Z [%{%d/%m/%y %H:%M}] %-15.15L (%?l?%4l&%4c?) %s"

bind pager j next-line
bind pager k previous-line
bind pager \Cd half-down
bind pager \Cu half-up
bind index \Cd half-down
bind index \Cu half-up

# Sidebar
set sidebar_visible = yes
set sidebar_width = 25
set sidebar_short_path = yes
set sidebar_next_new_wrap = yes
set mail_check_stats

color sidebar_highlight white default
color sidebar_indicator white blue

bind index,pager \Cp sidebar-prev
bind index,pager \Cn sidebar-next
bind index,pager \Co sidebar-open
bind index,pager B  sidebar-toggle-visible

color normal      default default
color indicator   black   blue          # selected line
color status      black   green         # status bar
color tree        red     default       # thread lines
color signature   cyan    default
color quoted      cyan    default       # quoted reply text
color attachment  yellow  default
color header      brightyellow default "^Subject:"
color header      brightblue   default "^From:"

color index brightred    default "~F"      # flagged
color index yellow       default "~N"      # new
color index yellow       default "~O"      # old
color index green        default "~P"      # from you
color index brightblack  default "~D"      # deleted
